*.so
*.o
*.a
simulator.c
build/
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/_cache/            # cached Bartlett/Fisher simulation blobs (regenerable)
tests/figures/           # test-generated figures

# Environments
.venv/
venv/
env/
.env

# Notebooks
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
